# Copy this file to .env and fill in your own values.
# Never commit .env. This example file contains no real values.
#
# Rules: one NAME=value per line, no spaces around the equals sign,
# no quotation marks. The file must sit in the project root.

# The App ID shown at the top of your GitHub App page (a number).
GITHUB_APP_ID=

# The installation ID: the number at the end of the installation address,
# for example settings/installations/12345678 (a number).
GITHUB_INSTALLATION_ID=

# Your GitHub user name or organization. A name only, no web address.
GITHUB_OWNER=

# The repository that receives the issues. A name only, no web address.
GITHUB_REPO=

# Local tests only: the path to your .pem key file.
# Use forward slashes, also on Windows.
# Windows example: C:/keys/feedback-relay.pem
# macOS example:   /Users/yourname/keys/feedback-relay.pem
GITHUB_PRIVATE_KEY_PATH=

# Online (Netlify dashboard): do not use the path above. Set this variable
# in the dashboard instead, with the key written as one line of base64 text.
# Treat it exactly like the key itself and never put it in a file you commit.
# GITHUB_PRIVATE_KEY_BASE64=
